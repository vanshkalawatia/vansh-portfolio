---
<section id="hero" class="scroll-mt-24">
  <div class="border-4 border-neo-border p-8 sm:p-12 bg-neo-card shadow-neo">
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-center lg:items-start">
      <div class="flex-shrink-0 flex flex-col gap-4 w-48 lg:w-64">
        <div class="w-48 h-48 lg:w-64 lg:h-64 border-4 border-neo-border shadow-neo-sm overflow-hidden bg-neo-accent">
          <img src="/images/avatar.png" alt="Vansh Kalawatia" class="w-full h-full object-cover bg-neo-bg" />
        </div>
        
        <!-- Tech Being Learned -->
        <div class="border-2 border-neo-border bg-neo-bg text-neo-text p-3 shadow-neo-sm">
          <p class="font-black text-xs uppercase tracking-wider text-neo-accent mb-2">Tech I'm Learning</p>
          <div class="flex flex-wrap gap-1.5 font-bold text-xs">
            <span class="bg-neo-card px-2 py-1 border border-neo-border">Java</span>
            <span class="bg-neo-card px-2 py-1 border border-neo-border">Spring Boot</span>
            <span class="bg-neo-card px-2 py-1 border border-neo-border">SQL</span>
            <span class="bg-neo-card px-2 py-1 border border-neo-border">Git</span>
            <span class="bg-neo-card px-2 py-1 border border-neo-border">Linux</span>
          </div>
        </div>

        <!-- Live GitHub Language Stats -->
        <div id="github-lang-stats" class="flex flex-col gap-2"></div>

        <!-- Live Study Streak Box -->
        <a href="#stats" class="block border-2 border-neo-border bg-neo-card text-neo-text p-3 shadow-neo-sm hover:translate-y-1 transition-all group mt-2">
          <div class="flex items-center justify-between mb-2">
            <span class="font-black text-xs uppercase tracking-wider text-red-600 dark:text-red-400 group-hover:underline flex items-center gap-1.5">
              <span>🔥</span> Study Streak
            </span>
            <span class="text-[10px] bg-yellow-400 text-black font-black px-1.5 py-0.5 animate-pulse">LIVE</span>
          </div>
          <div class="flex items-center justify-between font-black text-2xl">
            <span class="text-sm font-bold opacity-70 uppercase">Consecutive Days</span>
            <span id="hero-streak-counter" class="text-red-500">0</span>
          </div>
        </a>

        <!-- Live LeetCode Solved Box -->
        <a href="https://leetcode.com/u/vanshkalawatia/" target="_blank" id="leetcode-hero-box" class="block border-2 border-neo-border bg-neo-card text-neo-text p-3 shadow-neo-sm hover:translate-y-1 transition-all group mt-2">
          <div class="flex items-center justify-between mb-2">
            <span class="font-black text-xs uppercase tracking-wider text-yellow-600 dark:text-yellow-400 group-hover:underline flex items-center gap-1.5">
              <span>⚡</span> LeetCode Solved
            </span>
            <span class="text-[10px] bg-yellow-400 text-black font-black px-1.5 py-0.5">LIVE</span>
          </div>
          <div class="flex items-center justify-between font-black text-2xl mb-2">
            <span class="text-sm font-bold opacity-70 uppercase">Total Questions</span>
            <span id="lc-total-hero">10</span>
          </div>
          <div class="flex justify-between gap-1 text-xs font-black pt-2 border-t border-neo-border/40">
            <span class="bg-green-500/10 text-green-600 dark:text-green-400 px-1.5 py-0.5 border border-green-500/30">Easy: <span id="lc-easy-hero">8</span></span>
            <span class="bg-yellow-500/10 text-yellow-600 dark:text-yellow-400 px-1.5 py-0.5 border border-yellow-500/30">Med: <span id="lc-med-hero">2</span></span>
            <span class="bg-red-500/10 text-red-600 dark:text-red-400 px-1.5 py-0.5 border border-red-500/30">Hard: <span id="lc-hard-hero">0</span></span>
          </div>
        </a>
      </div>
      
      <div class="flex-1 text-center lg:text-left">
        <h2 class="text-5xl md:text-7xl font-black mb-2 tracking-tighter uppercase leading-none">Vansh</h2>
        <h2 class="text-5xl md:text-7xl font-black mb-6 tracking-tighter uppercase text-neo-accent leading-none">Kalawatia</h2>
        
        <div class="inline-block text-xl md:text-2xl font-bold mb-6 border-l-4 lg:border-l-0 lg:border-l-4 border-neo-border pl-4 text-left">
          3rd-year Computer Science student. Just starting out with backend development — Java and Spring Boot.
        </div>
        
        <p class="text-lg mb-8 max-w-2xl font-bold leading-relaxed text-left bg-yellow-300 dark:bg-yellow-500 text-black p-4 border-2 border-neo-border shadow-neo-sm">
          ⚠️ Not claiming expertise here. This is a learning log, not a portfolio yet.
        </p>
        
        <div class="flex justify-center lg:justify-start mb-8">
          <a 
            href="/resume.pdf" 
            target="_blank"
            class="inline-block bg-neo-accent text-white font-black text-xl px-8 py-4 border-4 border-neo-border shadow-neo hover:translate-y-1 hover:shadow-neo-sm active:translate-y-2 active:shadow-none transition-all uppercase"
          >
            Résumé
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  async function fetchGitHubLanguages() {
    const container = document.getElementById('github-lang-stats');
    if (!container) return;
    try {
      const res = await fetch('https://api.github.com/users/vanshkalawatia/repos?sort=created&direction=asc');
      if (!res.ok) return;
      const repos = await res.json();
      
      const langDates: Record<string, Date> = {};
      
      repos.forEach((repo: any) => {
        const n = repo.name.toLowerCase();
        if (n === 'vanshkalawatia' || n.includes('portfolio') || n.includes('astro') || n.includes('website') || n.includes('github.io')) return;
        const ignoreLangs = ['astro', 'html', 'css', 'scss', 'vue', 'svelte'];
        if (repo.language && !ignoreLangs.includes(repo.language.toLowerCase()) && !langDates[repo.language]) {
          langDates[repo.language] = new Date(repo.created_at);
        }
      });
      
      const now = new Date().getTime();
      const entries = Object.entries(langDates).map(([lang, date]) => {
        const days = Math.max(1, Math.ceil((now - date.getTime()) / (1000 * 60 * 60 * 24)));
        return { lang, days };
      });

      if (entries.length > 0) {
        container.innerHTML = `
          <div class="border-2 border-neo-border bg-neo-bg text-neo-text p-2 shadow-neo-sm mb-1 font-black text-xs uppercase tracking-wider text-neo-accent flex items-center justify-between">
            <span>Live GitHub Language Days</span>
            <span class="text-[10px] bg-neo-accent text-white px-1 py-0.5">SYNCED</span>
          </div>
        ` + entries.map(({ lang, days }) => `
          <div class="border-2 border-neo-border bg-neo-bg text-neo-text px-3 py-1.5 font-black text-sm shadow-neo-sm flex items-center justify-between">
            <span class="text-neo-accent uppercase tracking-wide">${lang}</span>
            <span>${String(days).padStart(2, '0')} <span class="text-xs uppercase font-bold opacity-70">Days</span></span>
          </div>
        `).join('');
      }
    } catch (e) {
      console.error('Failed to sync GitHub language stats:', e);
    }
  }

  async function fetchLeetCodeHeroStats() {
    try {
      let data: any = null;
      try {
        const res1 = await fetch('https://leetcode-api-faisalshohag.vercel.app/vanshkalawatia');
        if (res1.ok) data = await res1.json();
      } catch (err) {}
      
      if (!data || data.totalSolved === undefined) {
        const res2 = await fetch('https://alfa-leetcode-api.onrender.com/vanshkalawatia/solved');
        if (res2.ok) {
          const d = await res2.json();
          data = { totalSolved: d.solvedProblem, easySolved: d.easySolved, mediumSolved: d.mediumSolved, hardSolved: d.hardSolved };
        }
      }

      if (data && data.totalSolved !== undefined) {
        const totalEl = document.getElementById('lc-total-hero');
        const easyEl = document.getElementById('lc-easy-hero');
        const medEl = document.getElementById('lc-med-hero');
        const hardEl = document.getElementById('lc-hard-hero');
        if (totalEl) totalEl.textContent = String(data.totalSolved);
        if (easyEl) easyEl.textContent = String(data.easySolved);
        if (medEl) medEl.textContent = String(data.mediumSolved);
        if (hardEl) hardEl.textContent = String(data.hardSolved);
      }
    } catch (e) {
      console.error('Failed to sync LeetCode hero stats:', e);
    }
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    fetchGitHubLanguages();
    fetchLeetCodeHeroStats();
  });
</script>
